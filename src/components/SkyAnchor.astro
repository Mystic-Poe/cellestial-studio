---
// A meaningful star whose position the DOM owns; the canvas draws its light.
interface Props {
  kind: 'site' | 'systems' | 'app';
  left: string;
  top: string;
  label?: string;
}
const { kind, left, top, label } = Astro.props;
---

<span class="sky-anchor" data-sky-star={kind} style={`left:${left};top:${top}`}>
  <span class="sky-anchor__core" aria-hidden="true"></span>
  {label && <span class="sky-anchor__label">{label}</span>}
</span>

<style>
  .sky-anchor {
    position: absolute;
    width: 0;
    height: 0;
  }
  /* Visible without JS; the canvas glow sits behind it when JS runs. */
  .sky-anchor__core {
    position: absolute;
    left: -3px;
    top: -3px;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #fff;
    box-shadow:
      0 0 8px 2px var(--color-tier-site),
      0 0 24px 6px color-mix(in oklab, var(--color-tier-site) 35%, transparent);
  }
  .sky-anchor__label {
    position: absolute;
    left: 14px;
    top: 10px;
    white-space: nowrap;
    font-size: 0.625rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
</style>
