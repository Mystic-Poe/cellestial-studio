---
// The build request: the form whose Send claims a star. A panel, opened as a
// modal by the claim flow: a sheet rising from the bottom edge on a phone,
// centred on a wider screen.
import ContactForm from './ContactForm.astro';
import Panel from './ui/Panel.astro';
---

<Panel as="dialog" size="large" id="claim-dialog" class="panel--sheet" aria-labelledby="claim-title">
	<div class="panel__head">
		<h2 id="claim-title" class="panel__title">Claim your star</h2>
		<button class="panel__close" type="button" data-claim-close aria-label="Close"></button>
	</div>
	<p>Tell us what you want to build.</p>
	<ContactForm id="claim-form" turnstile="explicit" withStar />
</Panel>
