---
import home from '../../content/home.json';
---

<footer class="footer">
  <p>{home.footer.line}</p>
  <p>Stars: Yale Bright Star Catalog · lines: d3-celestial</p>
  <p><a href="/admin/">Studio login</a></p>
</footer>

<style>
  .footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0 1.5rem;
    max-width: 72rem;
    margin: 0 auto;
    padding: 2rem 1rem 3rem;
    border-top: 1px solid var(--color-hairline);
    color: var(--color-faint);
    font-size: 0.75rem;
  }
  .footer a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--color-faint);
  }
</style>
