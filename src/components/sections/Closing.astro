---
import home from '../../content/home.json';
import SkySlot from '../SkySlot.astro';
const c = home.closing;
---

<section class="closing" aria-labelledby="closing-title">
  <div class="closing__sky">
    <SkySlot id="slot-4" left="22%" top="40%" />
    <SkySlot id="slot-5" left="78%" top="60%" />
  </div>
  <h2 id="closing-title" class="display closing__title">{c.title} <em>{c.title_accent}</em></h2>
  <p class="closing__body">{c.body}</p>
  <a class="pill pill--primary" href="/contact" data-claim>{c.cta}</a>
</section>

<style>
  .closing {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    text-align: center;
    max-width: 72rem;
    margin: 0 auto;
    padding: 7rem 1rem 6rem;
  }
  .closing__sky {
    position: absolute;
    inset: 0;
  }
  .closing__title {
    position: relative;
    font-size: clamp(2.75rem, 8vw, 5rem);
    margin: 0;
  }
  .closing__body {
    position: relative;
    color: var(--color-secondary);
    max-width: 40ch;
    margin: 0;
  }
  .closing .pill {
    position: relative;
  }
</style>
