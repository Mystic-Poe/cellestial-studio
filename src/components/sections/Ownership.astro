---
import home from '../../content/home.json';
const o = home.ownership;
---

<section id="ownership" class="own" aria-labelledby="own-title">
  <p class="eyebrow">{o.eyebrow}</p>
  <h2 id="own-title" class="display own__title">{o.title} <em>{o.title_accent}</em></h2>
  <p class="own__body">{o.body}</p>
  <ul class="own__points">{o.points.map((p) => <li>{p}</li>)}</ul>
</section>

<style>
  .own {
    max-width: 72rem;
    margin: 0 auto;
    padding: 5rem 1rem;
  }
  .own__title {
    font-size: clamp(2.75rem, 8vw, 5rem);
    margin: 0.5rem 0 1.5rem;
  }
  .own__body {
    max-width: 52ch;
    color: var(--color-secondary);
    line-height: 1.7;
  }
  .own__points {
    display: grid;
    gap: 0.75rem;
    list-style: none;
    padding: 0;
    margin: 2rem 0 0;
  }
  @media (min-width: 48rem) {
    .own__points {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .own__points li {
    border-top: 1px solid var(--color-hairline);
    padding-top: 0.75rem;
    color: var(--color-muted);
    font-size: 0.8125rem;
  }
</style>
