---
import home from '../../content/home.json';
import ProofChips from '../ProofChips.astro';
import SkyAnchor from '../SkyAnchor.astro';
import SkySlot from '../SkySlot.astro';
const h = home.hero;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__copy">
    <p class="eyebrow">{h.eyebrow}</p>
    <h1 id="hero-title" class="display hero__title">{h.headline} <em>{h.headline_accent}</em></h1>
    <p class="hero__sub">{h.subcopy}</p>
    <div class="hero__actions">
      <a class="pill pill--primary" href="/contact" data-claim>{h.cta_primary}</a>
      <a class="pill pill--secondary" href="#work">{h.cta_secondary}</a>
    </div>
    <ProofChips chips={h.chips} />
  </div>
  <div class="hero__sky">
    <SkyAnchor kind="site" left="38%" top="46%" label="Star 00" />
    <SkySlot id="slot-1" left="70%" top="24%" />
    <SkySlot id="slot-2" left="84%" top="58%" />
    <SkySlot id="slot-3" left="56%" top="78%" />
  </div>
</section>

<style>
  .hero {
    display: grid;
    gap: 2rem;
    max-width: 72rem;
    margin: 0 auto;
    padding: 3rem 1rem 4rem;
    min-height: calc(100svh - 76px);
    align-items: center;
  }
  @media (min-width: 48rem) {
    .hero {
      grid-template-columns: 1.1fr 0.9fr;
      padding-top: 4rem;
    }
  }
  .hero__copy {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .hero__title {
    font-size: clamp(3rem, 9vw, 5.75rem);
    margin: 0;
  }
  .hero__sub {
    max-width: 36ch;
    color: var(--color-secondary);
    font-size: 0.9375rem;
    line-height: 1.6;
    margin: 0;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .hero__sky {
    position: relative;
    min-height: 18rem;
    height: 100%;
  }
</style>
