---
// An open star. Without JS it is a link to /contact; with JS the claim
// controller intercepts it and runs the ignition + dialog.
interface Props {
  id: `slot-${number}`;
  left: string;
  top: string;
}
const { id, left, top } = Astro.props;
const n = id.slice(5);
---

<a
  class="sky-slot"
  href="/contact"
  data-sky-star="slot"
  data-slot={id}
  data-state="open"
  style={`left:${left};top:${top}`}
  aria-label={`Claim open star ${n}`}
>
  <span class="sky-slot__ring" aria-hidden="true"></span>
  <span class="sky-slot__label" aria-hidden="true">your star</span>
</a>

<style>
  .sky-slot {
    position: absolute;
    width: 44px;
    height: 44px;
    margin: -22px 0 0 -22px;
    border-radius: 50%;
    display: grid;
    place-items: center;
  }
  .sky-slot__ring {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    border: 1px dashed color-mix(in oklab, var(--color-tier-slot) 70%, transparent);
    animation: slot-turn 14s linear infinite;
  }
  .sky-slot:hover .sky-slot__ring,
  .sky-slot:focus-visible .sky-slot__ring {
    border-color: var(--color-glow);
  }
  .sky-slot__label {
    position: absolute;
    top: 40px;
    white-space: nowrap;
    font-size: 0.625rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-glow);
    opacity: 0;
    transition: opacity 600ms ease;
  }
  .sky-slot[data-state='held'] .sky-slot__ring,
  .sky-slot[data-state='pending'] .sky-slot__ring {
    opacity: 0;
  }
  .sky-slot[data-state='held'] .sky-slot__label {
    opacity: 1;
  }
  /* Only without JS: when JS runs, Base's boot script sets data-motion and the switch governs. */
  @media (prefers-reduced-motion: reduce) {
    :global(html:not([data-motion])) .sky-slot__ring {
      animation: none;
    }
  }
  @keyframes slot-turn {
    to {
      transform: rotate(360deg);
    }
  }
</style>
