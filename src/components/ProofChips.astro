---
interface Props {
  chips: string[];
}
const { chips } = Astro.props;
---

<ul class="chips" aria-label="Proof">
  {chips.map((c) => <li class="chip">{c}</li>)}
  <li class="chip chip--live" data-loadtime hidden></li>
</ul>

<style>
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .chip {
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 0.35rem 0.75rem;
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    color: var(--color-muted);
  }
  .chip--live {
    border-color: color-mix(in oklab, var(--color-glow) 40%, transparent);
    color: var(--color-glow);
  }
</style>

<script>
  // Measured in the visitor's own browser, not claimed.
  const chip = document.querySelector<HTMLLIElement>('[data-loadtime]');
  const show = () => {
    const nav = performance.getEntriesByType('navigation')[0] as PerformanceNavigationTiming | undefined;
    if (!chip || !nav || nav.loadEventEnd <= 0) return;
    chip.textContent = `Loaded in ${(nav.loadEventEnd / 1000).toFixed(2)}s, on your device`;
    chip.hidden = false;
  };
  if (document.readyState === 'complete') setTimeout(show, 0);
  else addEventListener('load', () => setTimeout(show, 0), { once: true });
</script>
