---
// Stills every animation on the site. Defaults to the visitor's system
// reduced-motion setting (set in Base.astro's head script); remembers a choice.
---

<button class="motion-switch" type="button" aria-pressed="true" data-motion-switch>
  <span class="motion-switch__dot" aria-hidden="true"></span>
  <span class="motion-switch__label">Motion</span>
</button>

<style>
  .motion-switch {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 44px;
    padding: 0 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: transparent;
    color: var(--color-muted);
    font: 500 0.6875rem/1 var(--font-plex-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    cursor: pointer;
  }
  .motion-switch__dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--color-glow);
    box-shadow: 0 0 0.5rem var(--color-glow);
  }
  .motion-switch[aria-pressed='false'] .motion-switch__dot {
    background: var(--color-faint);
    box-shadow: none;
  }
  .motion-switch[aria-pressed='false'] {
    color: var(--color-faint);
  }
</style>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-motion-switch]');
  const root = document.documentElement;
  const sync = () => btn?.setAttribute('aria-pressed', String(root.dataset.motion !== 'off'));
  sync();
  btn?.addEventListener('click', () => {
    const on = root.dataset.motion === 'off';
    root.dataset.motion = on ? 'on' : 'off';
    try {
      localStorage.setItem('cellestial:motion', root.dataset.motion);
    } catch {
      // Storage blocked: the choice lasts for this page view only.
    }
    sync();
    window.dispatchEvent(new CustomEvent('cellestial:motion', { detail: { on } }));
  });
</script>
