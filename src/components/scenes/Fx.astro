---
// PLACEHOLDER for the effects layer (C4, the D2 impact, G2). The effects scene
// replaces this file and src/experience/fx/index.ts.
//
// One canvas over every scene and under the chrome. It never takes a click.
---

<canvas id="fx-canvas" aria-hidden="true"></canvas>

<style is:global>
	#fx-canvas {
		position: fixed;
		inset: 0;
		z-index: 30;
		display: block;
		width: 100%;
		height: 100%;
		pointer-events: none;
	}
</style>
