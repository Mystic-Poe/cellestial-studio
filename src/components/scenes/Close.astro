---
// The Close (F1, F2): the bottom of the descent. The two closing actions, F2
// directly under F1, and nothing else: no heading, no footer, no small print.
//
// Each is a link to /contact, which is what it is without script. With it,
// the claim flow (src/experience/claim-flow.ts) hears data-open-claim and
// data-open-contact on the document and opens the build request or the
// message box instead. The mycelium's trunk ends at the top of F1.
import BrassButton from '../ui/BrassButton.astro';
---

<div class="roots-close">
	<BrassButton variant="primary" href="/contact" data-open-claim>Claim your star</BrassButton>
	<BrassButton variant="quiet" href="/contact" data-open-contact>Contact me</BrassButton>
</div>

<style is:global>
	.roots-close {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1.5rem;
		padding: 2rem 1rem 7.5rem;
	}
	/* As written (no script), the last tile is just above: give it air. */
	#roots:not([data-live]) .roots-close {
		padding-top: 4rem;
	}
</style>
