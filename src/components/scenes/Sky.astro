---
// The Sky (B): the canvas the flight is drawn on, and the layer its controls
// live in. src/experience/sky/index.ts mounts on these two elements.
//
// The canvas is the picture and is hidden from assistive tech; every star of
// the layer in front has a real, transparent <button> in #sky-ui, kept over
// it by the scene, and that is what a visitor picks with.
//
// B11, the exit button, is the only words in the sky. It is in the markup from
// the start and hidden: the scene shows it once one full round has been flown
// (or at once under reduced motion), and it stays.
//
// The two small panels are here too, hidden: B10, what Cellestial can build,
// beside an empty star (its five lines are the locked offer copy: each offer's
// short name and its lead, and nothing else), and the panel beside a lit star,
// which shows the ask of that claim and nothing else. src/experience/sky/panels.ts
// shows and places them.
import { OFFERS } from '../../content/offers.ts';
import BrassButton from '../ui/BrassButton.astro';
import Panel from '../ui/Panel.astro';
---

<canvas id="sky-canvas" aria-hidden="true"></canvas>
<div id="sky-ui" role="region" aria-label="The Sky" tabindex="-1">
	<p class="sky-claim" data-claim-words data-glow="claim yours" hidden>claim yours</p>
	<Panel
		size="small"
		class="sky-panel sky-panel--empty"
		data-sky-panel="empty"
		role="dialog"
		aria-labelledby="sky-claim-star"
		tabindex="-1"
		hidden
	>
		<button class="panel__close" type="button" aria-label="Close" data-sky-close></button>
		<ul class="sky-offers">
			{OFFERS.map((offer) => <li><strong>{offer.short}</strong>{' '}{offer.lead}</li>)}
		</ul>
		<BrassButton variant="small" id="sky-claim-star" data-sky-claim>Claim your star</BrassButton>
	</Panel>
	<Panel
		size="small"
		class="sky-panel sky-panel--lit"
		data-sky-panel="lit"
		role="dialog"
		aria-labelledby="sky-ask"
		tabindex="-1"
		hidden
	>
		<button class="panel__close" type="button" aria-label="Close" data-sky-close></button>
		<p class="sky-ask" id="sky-ask" data-sky-ask></p>
	</Panel>
	<div class="sky-exit">
		<BrassButton data-descend hidden>See what holds up the sky</BrassButton>
	</div>
</div>

<style is:global>
	#sky-canvas {
		position: fixed;
		inset: 0;
		z-index: 0;
		display: block;
		width: 100%;
		height: 100%;
		background: #000;
		/* The flight owns a touch that begins on the sky. */
		touch-action: none;
		-webkit-tap-highlight-color: transparent;
		user-select: none;
		-webkit-user-select: none;
	}

	#sky-ui {
		position: fixed;
		inset: 0;
		z-index: 2;
		overflow: hidden;
		pointer-events: none;
	}

	#sky-ui .sky-stars {
		position: absolute;
		inset: 0;
		pointer-events: none;
	}

	#sky-ui .sky-stars[hidden] {
		display: none;
	}

	/* One per star of the layer in front. The scene sets its size and place. */
	#sky-ui .sky-star {
		position: absolute;
		top: 0;
		left: 0;
		width: 44px;
		height: 44px;
		margin: -22px 0 0 -22px;
		padding: 0;
		border: 0;
		border-radius: 50%;
		background: transparent;
		color: inherit;
		font: inherit;
		appearance: none;
		-webkit-appearance: none;
		cursor: pointer;
		pointer-events: auto;
		touch-action: none;
		-webkit-tap-highlight-color: transparent;
		outline: none;
		will-change: transform;
	}

	#sky-ui .sky-star[hidden] {
		display: none;
	}

	#sky-ui .sky-star:focus-visible {
		outline: 2px solid var(--color-brass-hi, #d5ae88);
		outline-offset: 3px;
	}

	/* B9: the words under the star the beads reached. The scene keeps them
	   under the star (transform) and breathes their glow with it (--pulse, 0 to
	   1). The words themselves stay whole, so they can always be read; what
	   breathes is a second layer of light over them, and only its opacity
	   changes, which costs a phone nothing. */
	#sky-ui .sky-claim {
		position: absolute;
		top: 0;
		left: 0;
		margin: 0;
		padding: 4px 8px;
		translate: -50% 0;
		color: var(--color-brass-text);
		font-family: var(--font-sans);
		font-size: 0.8125rem;
		font-weight: 600;
		line-height: 1.2;
		letter-spacing: 0.06em;
		white-space: nowrap;
		text-shadow: 0 0 4px color-mix(in srgb, var(--color-brass-hi) 30%, transparent);
		cursor: pointer;
		pointer-events: auto;
		user-select: none;
		-webkit-user-select: none;
		-webkit-tap-highlight-color: transparent;
		will-change: transform;
	}
	#sky-ui .sky-claim::after {
		content: attr(data-glow);
		position: absolute;
		inset: 0;
		padding: inherit;
		color: color-mix(in srgb, var(--color-brass-hi) 55%, transparent);
		text-shadow:
			0 0 10px color-mix(in srgb, var(--color-brass-hi) 85%, transparent),
			0 0 3px color-mix(in srgb, var(--color-brass-hi) 60%, transparent);
		opacity: var(--pulse, 1);
		pointer-events: none;
		will-change: opacity;
	}
	#sky-ui .sky-claim[hidden] {
		display: none;
	}

	/* B7, a complete figure's meaning (src/experience/sky/meaning.ts makes the
	   element and keeps it with its figure). Each letter is three things: the
	   letter itself in brass, lit from above; over it the same letter white-hot,
	   which is how it is struck and what cools away; and inside it the same
	   letter again in a lighter weight, pared down to a thin blue line: the
	   circuit in the brass, as in the wordmark's letters. */
	#sky-ui .sky-meaning {
		position: absolute;
		top: 0;
		left: 0;
		margin: 0;
		color: var(--color-brass-text);
		font-family: var(--font-sans);
		font-weight: 700;
		line-height: 1.3;
		text-align: center;
		white-space: nowrap;
		transform-origin: 50% 0;
		filter: drop-shadow(0 1px 2px rgb(0 0 0 / 0.9));
		pointer-events: none;
		user-select: none;
		-webkit-user-select: none;
		will-change: transform, opacity;
	}
	#sky-ui .sky-meaning[hidden] {
		display: none;
	}
	.sky-meaning__line {
		display: block;
		/* On a narrow screen a long line may stand in two or three rows: even ones. */
		text-wrap: balance;
	}
	/* The final line stands apart from the meaning it follows. */
	.sky-meaning__line + .sky-meaning__line {
		margin-top: 0.42em;
	}
	/* Read, not seen. */
	.sky-meaning__say {
		position: absolute;
		width: 1px;
		height: 1px;
		margin: -1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}
	.sky-meaning__word {
		display: inline-block;
	}
	.sky-meaning i {
		position: relative;
		display: inline-block;
		/* The site's brass, lit from above as the wordmark's letters are: what
		   shows of this layer is the letter's rim, its bevel, light on top and
		   in shadow underneath; the face is laid over it by ::after. */
		background: linear-gradient(
			to bottom,
			var(--color-brass-hi) 30%,
			var(--color-brass-text) 58%,
			var(--color-brass) 92%
		);
		-webkit-background-clip: text;
		background-clip: text;
		font-style: normal;
		-webkit-text-fill-color: transparent;
		-webkit-text-stroke: 0.012em var(--color-brass-text);
		opacity: 0;
	}
	.sky-meaning i + i {
		margin-left: 0.05em;
	}
	.sky-meaning i::before,
	.sky-meaning i::after {
		content: attr(data-ch);
		position: absolute;
		top: 0;
		right: 0;
		left: 0;
		opacity: 0;
		pointer-events: none;
	}
	.sky-meaning i::before {
		-webkit-text-fill-color: var(--color-blue-white);
		-webkit-text-stroke: 0.03em var(--color-blue-white);
		text-shadow:
			0 0 0.3em var(--color-blue-white),
			0 0 0.7em var(--color-blue);
	}
	/* The thin blue line set in the brass: the same letter in the lightest
	   weight, in the blue, with a stroke of the brass laid over its edges so
	   that only the middle of each stroke is left. A line, not a blue letter:
	   the brass round it stays brass. */
	.sky-meaning i::after {
		font-weight: 400;
		-webkit-text-fill-color: var(--color-blue);
		-webkit-text-stroke: var(--groove, 0.038em) var(--color-brass-text);
		paint-order: fill stroke;
		transform: scaleX(var(--sx, 1));
	}
	.sky-meaning i[data-on] {
		opacity: 1;
	}
	.sky-meaning i[data-on]::before {
		animation: sky-meaning-cool 1s ease-out both;
	}
	.sky-meaning i[data-on]::after {
		animation: sky-meaning-line 1s ease-out both;
	}
	/* Written: simply there. (An element that comes back from display: none
	   would otherwise cool all over again.) */
	.sky-meaning[data-settled] i,
	html[data-motion='off'] .sky-meaning i {
		opacity: 1;
	}
	.sky-meaning[data-settled] i::before,
	html[data-motion='off'] .sky-meaning i::before {
		animation: none;
		opacity: 0;
	}
	.sky-meaning[data-settled] i::after,
	html[data-motion='off'] .sky-meaning i::after {
		animation: none;
		opacity: 1;
	}
	.sky-meaning canvas {
		position: absolute;
		pointer-events: none;
	}
	@keyframes sky-meaning-cool {
		0%,
		18% {
			opacity: 1;
		}
		100% {
			opacity: 0;
		}
	}
	@keyframes sky-meaning-line {
		0%,
		35% {
			opacity: 0;
		}
		100% {
			opacity: 1;
		}
	}

	/* The two small panels. The scene puts them beside their star (transform). */
	#sky-ui .sky-panel {
		position: absolute;
		top: 0;
		left: 0;
		/* Over the exit button, where a short screen leaves no room beside it. */
		z-index: 2;
		max-width: min(19rem, calc(100% - 1.5rem));
		max-height: calc(100% - 1.5rem);
		overflow: auto;
		overscroll-behavior: contain;
		scrollbar-width: thin;
		scrollbar-color: var(--color-brass) transparent;
		pointer-events: auto;
		outline: none;
		animation: sky-panel-in 220ms ease-out both;
	}
	#sky-ui .sky-panel[hidden] {
		display: none;
	}
	@keyframes sky-panel-in {
		from {
			opacity: 0;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		#sky-ui .sky-panel {
			animation: none;
		}
	}
	html[data-motion='off'] #sky-ui .sky-panel {
		animation: none;
	}

	/* B10: five lines, the offer's name in brass and its lead in white. */
	.sky-offers {
		margin: 0;
		padding: 0;
		list-style: none;
	}
	#sky-ui .sky-panel--empty {
		width: min(21rem, calc(100% - 1.5rem));
		max-width: none;
		line-height: 1.4;
	}
	.sky-offers li + li {
		margin-top: 0.4em;
	}
	/* The close button stands in the corner beside the first line. */
	.sky-offers li:first-child {
		padding-right: 1.75rem;
	}
	.sky-offers strong {
		margin-right: 0.3em;
	}
	#sky-ui .sky-panel--empty > .brass-btn {
		margin-top: 0.875rem;
	}

	/* A short screen (a phone with its browser's bars showing): the same words,
	   set tighter, so that there is room for the panel beside more of the stars. */
	@media (max-height: 760px) {
		#sky-ui .sky-panel--empty {
			--panel-pad-y: 0.625rem;
			font-size: 0.875rem;
			line-height: 1.35;
		}
		#sky-ui .sky-panel--empty .sky-offers li + li {
			margin-top: 0.3em;
		}
		#sky-ui .sky-panel--empty > .brass-btn {
			margin-top: 0.625rem;
		}
	}

	/* The lit star's panel: the ask, as it was written. A long one scrolls here. */
	.sky-ask {
		max-height: min(15rem, 45vh);
		padding-right: 1.75rem;
		overflow: auto;
		overscroll-behavior: contain;
		white-space: pre-wrap;
		overflow-wrap: anywhere;
		scrollbar-width: thin;
		scrollbar-color: var(--color-brass) transparent;
	}
	.sky-ask[data-more] {
		mask-image: linear-gradient(to bottom, #000 calc(100% - 2.25rem), transparent);
	}
	.sky-ask:focus-visible {
		outline: 2px solid var(--color-brass-hi, #d5ae88);
		outline-offset: 2px;
	}

	/* B11: bottom centre. The button is centred by its row, not by a transform,
	   so the kit's pressed state (a transform of its own) cannot move it. */
	.sky-exit {
		position: absolute;
		z-index: 1;
		inset: auto 0 0;
		display: flex;
		justify-content: center;
		padding: 0 1rem max(2rem, calc(env(safe-area-inset-bottom) + 1.25rem));
	}
	.sky-exit > * {
		pointer-events: auto;
	}
	/* It comes up out of the black once, when the round is flown. */
	.sky-exit > [data-arriving] {
		animation: sky-exit-in 900ms ease-out both;
	}
	@keyframes sky-exit-in {
		from {
			opacity: 0;
			translate: 0 0.5rem;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.sky-exit > [data-arriving] {
			animation: none;
		}
	}
	html[data-motion='off'] .sky-exit > [data-arriving] {
		animation: none;
	}
</style>
