---
// PLACEHOLDER for the sky (B1 → B11, G1). The sky scene replaces this file and
// src/experience/sky/index.ts.
//
// A black canvas, and over it the layer that will hold the star buttons, B10
// and B11. Only B11 is here: hidden until the visitor has flown the round,
// which the stub counts as the first wheel, swipe or flight key.
import BrassButton from '../ui/BrassButton.astro';
---

<canvas id="sky-canvas" aria-hidden="true"></canvas>
<div id="sky-ui" role="region" aria-label="The Sky" tabindex="-1">
	<div class="sky-exit">
		<BrassButton data-descend hidden>See what holds up the sky</BrassButton>
	</div>
</div>

<style is:global>
	#sky-canvas {
		position: fixed;
		inset: 0;
		z-index: 0;
		display: block;
		width: 100%;
		height: 100%;
		background: #000;
	}

	/* The layer itself lets a click through to the canvas; what is on it does not. */
	#sky-ui {
		position: fixed;
		inset: 0;
		z-index: 2;
		pointer-events: none;
	}

	/* B11: bottom centre. The button is centred by its row, not by a transform,
	   so the kit's pressed state (a transform of its own) cannot move it. */
	.sky-exit {
		position: absolute;
		inset: auto 0 0;
		display: flex;
		justify-content: center;
		padding: 0 1rem max(2rem, calc(env(safe-area-inset-bottom) + 1.25rem));
	}
	.sky-exit > * {
		pointer-events: auto;
	}
</style>
