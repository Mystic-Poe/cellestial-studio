---
import { TURNSTILE_SITE_KEY } from '../config.ts';

interface Props {
  id: string;
  turnstile: 'implicit' | 'explicit';
  withStar?: boolean;
}
const { id, turnstile, withStar = false } = Astro.props;
const ready = TURNSTILE_SITE_KEY !== '';
---

<form id={id} method="POST" action="/api/contact" class="cform" novalidate>
  <div class="cform__field">
    <label for={`${id}-name`}>Your name</label>
    <input id={`${id}-name`} name="name" type="text" required maxlength="120" autocomplete="name" />
  </div>
  <div class="cform__field">
    <label for={`${id}-email`}>Email</label>
    <input id={`${id}-email`} name="email" type="email" required maxlength="254" autocomplete="email" />
  </div>
  <div class="cform__field">
    <label for={`${id}-message`}>What do you need built?</label>
    <textarea id={`${id}-message`} name="message" rows="5" required maxlength="5000"></textarea>
  </div>
  {withStar && <input type="hidden" name="star" value="" data-star-input />}
  {
    ready &&
      (turnstile === 'implicit' ? (
        <div class="cf-turnstile" data-sitekey={TURNSTILE_SITE_KEY} data-theme="dark" />
      ) : (
        <div data-turnstile-slot data-sitekey={TURNSTILE_SITE_KEY} />
      ))
  }
  <button class="pill pill--primary cform__send" type="submit" disabled={!ready}>Send</button>
  <p class="cform__status" data-status role="status" aria-live="polite"></p>
</form>

<style>
  .cform {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }
  .cform__field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  /* Pale labels over black fields with a brass hairline. */
  .cform label {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-secondary);
  }
  .cform input,
  .cform textarea {
    border: 1px solid var(--color-brass);
    border-radius: 10px;
    background: var(--color-black);
    color: var(--color-white);
    padding: 0.65rem 0.8rem;
    font: inherit;
    transition:
      border-color 160ms ease-out,
      box-shadow 160ms ease-out;
  }
  .cform textarea {
    min-height: 7.5rem;
    resize: vertical;
  }
  .cform input:hover,
  .cform textarea:hover {
    border-color: var(--color-brass-text);
  }
  .cform input:focus-visible,
  .cform textarea:focus-visible {
    border-color: var(--color-blue);
    outline: 2px solid var(--color-blue);
    outline-offset: 2px;
    box-shadow: 0 0 12px 0 color-mix(in srgb, var(--color-blue) 45%, transparent);
  }
  /* A field the browser filled in keeps its black face. */
  .cform input:autofill {
    -webkit-text-fill-color: #fff;
    box-shadow: inset 0 0 0 100px var(--color-black);
    caret-color: #fff;
  }
  /* Turnstile's iframe never goes below 300px wide, even with size: 'flexible'.
     On a screen too narrow to give it that, scale it to fit. */
  @media (max-width: 22.75rem) {
    .cform .cf-turnstile,
    .cform [data-turnstile-slot] {
      height: 56px;
      transform: scale(0.85);
      transform-origin: top left;
    }
  }
  /* Turnstile's frame can paint white for an instant before it draws itself
     dark (seen once, on a phone, in the first frame of an opening dialog). Its
     place is kept unseen for the first moments it is on screen, then let in.
     Surface only: the widget, its script and the form's markup are untouched. */
  .cform .cf-turnstile,
  .cform [data-turnstile-slot] {
    animation: cform-widget-in 520ms linear both;
  }
  @keyframes cform-widget-in {
    0%,
    60% {
      opacity: 0;
    }
    100% {
      opacity: 1;
    }
  }
  /* Send is the brass button: .pill is its old name (see BrassButton.astro). */
  .cform__send {
    align-self: flex-start;
  }
  .cform__status {
    min-height: 1.5em;
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--color-white);
  }
</style>
