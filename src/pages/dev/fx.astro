---
// Test page for the effects layer alone. Dev only: src/pages/dev/ is deleted
// before the final build. The parameters are listed in
// src/experience/fx/dev/harness.ts.
import Fx from '../../components/scenes/Fx.astro';

// A test card, not copy: rows of large dark figures for the cover to hide.
const rows = Array.from({ length: 14 }, (_, r) => '0123456789'.slice(r % 5) + '0123456789');
---

<!doctype html>
<html lang="en" data-bg="black">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex" />
		<title>fx</title>
		<style is:global>
			html,
			body {
				margin: 0;
				height: 100%;
				overflow: hidden;
				background: #000;
			}
			.bg {
				position: fixed;
				inset: 0;
				display: none;
			}
			html[data-bg='soil'] .bg-soil,
			html[data-bg='split'] .bg-split,
			html[data-bg='bright'] .bg-bright {
				display: block;
			}
			.bg-soil,
			.bg-split .ground {
				background: #1d1817 url('/cellestial/roots/soil-landscape.webp') top center / 1920px auto
					repeat;
			}
			/* Black above a ground whose top edge is at 62% of the height. */
			.bg-split .ground {
				position: absolute;
				inset: 62% 0 0 0;
			}
			.bg-bright {
				background: #f3f1ea;
				color: #14110f;
				font: 900 22vmin/0.86 system-ui, sans-serif;
				letter-spacing: -0.04em;
				overflow: hidden;
				white-space: nowrap;
			}
		</style>
	</head>
	<body>
		<div class="bg bg-soil"></div>
		<div class="bg bg-split"><div class="ground"></div></div>
		<div class="bg bg-bright" aria-hidden="true">
			{rows.map((row) => <div>{row}</div>)}
		</div>
		<Fx />
		<script>
			import { boot } from '../../experience/fx/dev/harness.ts';

			boot();
		</script>
	</body>
</html>
