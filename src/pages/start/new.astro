---
import Base from '../../layouts/Base.astro';

const field = 'w-full rounded-md border border-border bg-card px-3 py-2 text-body';
const label = 'flex flex-col gap-1 text-sm text-label';
---

<Base title="New client link — Cellestial Studio" description="Build a client onboarding link.">
	<meta slot="head" name="robots" content="noindex, nofollow" />
	<main id="main" class="mx-auto flex min-h-dvh max-w-md flex-col gap-6 px-5 py-10">
		<header class="flex flex-col gap-2">
			<p class="text-xs uppercase tracking-widest text-label">Studio only</p>
			<h1 class="display text-4xl">New client link</h1>
			<p class="text-sm text-secondary">
				Nothing here is saved or sent anywhere. The details live inside the link itself.
			</p>
		</header>

		<form class="flex flex-col gap-4" data-builder>
			<label class={label}>Business name
				<input class={field} name="name" required maxlength="80" autocomplete="off" />
			</label>
			<label class={label}>Business email
				<input class={field} name="email" type="email" required maxlength="254" autocomplete="off" />
			</label>
			<label class={label}>Domain
				<input class={field} name="domain" required maxlength="253" placeholder="example.com" autocomplete="off" />
			</label>

			<fieldset class="flex flex-col gap-2 text-sm">
				<legend class="mb-1 text-label">Does their business run on…</legend>
				<label class="flex gap-2"><input type="radio" name="lane" value="ms" checked /> Microsoft (default)</label>
				<label class="flex gap-2"><input type="radio" name="lane" value="g" /> Google</label>
			</fieldset>

			<fieldset class="flex flex-col gap-2 text-sm">
				<legend class="mb-1 text-label">Tier</legend>
				<label class="flex gap-2"><input type="radio" name="tier" value="2" checked /> Tier 2/3 — GitHub + Cloudflare</label>
				<label class="flex gap-2"><input type="radio" name="tier" value="1" /> Tier 1 — Cloudflare only (repo stays in the studio org)</label>
			</fieldset>

			<fieldset class="flex flex-col gap-2 text-sm">
				<legend class="mb-1 text-label">How you'll run it</legend>
				<label class="flex gap-2"><input type="radio" name="mode" value="person" checked /> In person — no emails</label>
				<label class="flex gap-2"><input type="radio" name="mode" value="remote" /> Remote — email me at each step</label>
				<label class="flex gap-2"><input type="radio" name="mode" value="test" /> Test — like remote, emails marked [TEST]</label>
			</fieldset>
		</form>

		<section class="flex flex-col gap-3" data-out hidden>
			<h2 class="text-sm uppercase tracking-widest text-label">Their link</h2>
			<a class="break-all text-xs text-glow underline" target="_blank" rel="noopener" data-link></a>
			<div class="flex gap-3">
				<button type="button" class="flex-1 rounded-full bg-glow px-4 py-3 font-semibold text-night" data-copy-link>Copy link</button>
			</div>
			<p class="min-h-5 text-sm text-glow" data-builder-status aria-live="polite"></p>
			<div class="mx-auto w-56 rounded-md bg-white p-2" data-qr aria-label="QR code of the link"></div>
			<p class="text-center text-xs text-faint">Scan with their phone, or open the link on their laptop.</p>
		</section>

		<section class="flex flex-col gap-3 border-t border-hairline pt-6">
			<h2 class="text-sm uppercase tracking-widest text-label">Your side, after they finish</h2>
			<ol class="flex list-decimal flex-col gap-3 pl-5 text-sm text-secondary">
				<li>Accept the GitHub org invite —
					<a class="text-glow underline" href="https://github.com/settings/organizations" target="_blank" rel="noopener">your organizations</a> (Tier 2/3).</li>
				<li>Accept the Cloudflare invite from the email Cloudflare sends you.</li>
				<li>In <strong>their</strong> account, add the studio card —
					<a class="text-glow underline" href="https://dash.cloudflare.com/?to=/:account/billing" target="_blank" rel="noopener">Billing</a>.</li>
				<li>Buy <span class="text-body" data-domain>their domain</span> —
					<a class="text-glow underline" href="https://dash.cloudflare.com/?to=/:account/registrar/register" target="_blank" rel="noopener">Registrar</a>.</li>
			</ol>
			<p class="text-xs text-faint">Cloudflare links open whichever account is selected — switch to the client's first.</p>
		</section>
	</main>
	<style>
		input[type='radio'] {
			accent-color: var(--color-glow);
		}
	</style>
	<script>
		import { wireBuilder } from '../../scripts/start-builder.ts';
		const form = document.querySelector<HTMLFormElement>('[data-builder]');
		if (form) wireBuilder(form);
	</script>
</Base>
