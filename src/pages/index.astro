---
import Base from '../layouts/Base.astro';
import home from '../content/home.json';
import StarGlowButton from '../components/StarGlowButton.astro';
---

<Base
	title={`Cellestial Studio — ${home.tagline}`}
	description={`${home.headline} — ${home.tagline}`}
>
	<main class="mx-auto flex min-h-screen max-w-2xl flex-col justify-center gap-6 px-6 py-16">
		<h1 class="text-4xl font-semibold tracking-tight">{home.headline}</h1>
		<p class="text-lg text-silver">{home.tagline}</p>
		<p><StarGlowButton href="/contact" label={home.cta_label} /></p>
	</main>
</Base>
