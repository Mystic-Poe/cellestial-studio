---
import ClaimDialog from '../components/ClaimDialog.astro';
import Header from '../components/Header.astro';
import Sky from '../components/Sky.astro';
import Closing from '../components/sections/Closing.astro';
import Footer from '../components/sections/Footer.astro';
import Hero from '../components/sections/Hero.astro';
import Horizon from '../components/sections/Horizon.astro';
import Ownership from '../components/sections/Ownership.astro';
import Soil from '../components/sections/Soil.astro';
import Work from '../components/sections/Work.astro';
import home from '../content/home.json';
import Base from '../layouts/Base.astro';
---

<Base title={home.meta.title} description={home.meta.description}>
  <Sky />
  <Header cta={home.hero.cta_primary} />
  <main id="main">
    <Hero />
    <Work />
    <Horizon />
    <Soil />
    <Ownership />
    <Closing />
  </main>
  <Footer />
  <ClaimDialog />
  <script>
    import '../scripts/claim-controller.ts';
  </script>
</Base>
