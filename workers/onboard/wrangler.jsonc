{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "cellestial-onboard",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-10",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "observability": { "enabled": true },
  // Trailing * so every sub-path and query string matches.
  "routes": [
    {
      "pattern": "cellestialstudio.com/api/onboard*",
      "zone_name": "cellestialstudio.com"
    }
  ],
  // 5 emails per minute per IP. Caps how hard anyone can make Gabriel's inbox ring.
  "ratelimits": [
    {
      "name": "RATE",
      "namespace_id": "1701",
      "simple": { "limit": 5, "period": 60 }
    },
    // 60 writes (saves, photo uploads, review answers) per minute per client link.
    {
      "name": "RATE_CLIENT",
      "namespace_id": "1703",
      "simple": { "limit": 60, "period": 60 }
    },
    // 120 photo views per minute per client link: even a link hammered all
    // month stays under half of R2's 10M free reads (and the edge cache
    // answers most repeats before R2 is asked).
    {
      "name": "RATE_READ",
      "namespace_id": "1704",
      "simple": { "limit": 120, "period": 60 }
    }
  ],
  // Client records. Schema in migrations/; apply with
  // `wrangler d1 migrations apply cellestial-onboard --remote --config workers/onboard/wrangler.jsonc`.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cellestial-onboard",
      "database_id": "f95e8c28-527e-4374-b85e-ef82e99b0ec6",
      "migrations_dir": "migrations"
    }
  ],
  // Photo files (private; every read goes through this Worker). Keys:
  // c/<client id>/<photo id>[.thumb]
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "cellestial-onboard-photos"
    }
  ],
  // Cloudflare Access app "Onboarding dashboard" (guards /dashboard and
  // /api/onboard/admin). Neither value is secret: the team domain is the login
  // page and the AUD is inside every Access token.
  "vars": {
    "ACCESS_TEAM": "late-dawn-ae37.cloudflareaccess.com",
    "ACCESS_AUD": "96bc4eddbce40a3ce5e145bd58024c4eb3be2bb0189477fe11aeda666298c0fa"
  },
  // Secrets are set by Gabriel on this Worker; see README. keep_vars stops a
  // deploy from wiping NOTIFY_TO / NOTIFY_FROM set in the dashboard.
  "keep_vars": true
}
