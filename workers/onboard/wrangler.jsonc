{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "cellestial-onboard",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-10",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "observability": { "enabled": true },
  // Trailing * so the sub-paths (/invites, /ping) and query strings match.
  "routes": [
    {
      "pattern": "cellestialstudio.com/api/onboard*",
      "zone_name": "cellestialstudio.com"
    }
  ],
  // 5 pings per minute per IP. Caps how hard anyone can make Gabriel's inbox ring.
  "ratelimits": [
    {
      "name": "RATE",
      "namespace_id": "1701",
      "simple": { "limit": 5, "period": 60 }
    },
    // 30 progress writes per minute per client link.
    {
      "name": "RATE_PROGRESS",
      "namespace_id": "1702",
      "simple": { "limit": 30, "period": 60 }
    }
  ],
  // Secrets are set by Gabriel on this Worker; see README. keep_vars stops a
  // deploy from wiping NOTIFY_TO / NOTIFY_FROM set in the dashboard.
  "keep_vars": true
}
