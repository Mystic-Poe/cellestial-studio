[
	{ "route": { "url": "**/api/contact", "status": 200, "json": { "ok": true } } },
	{ "wait": 1500 },
	{ "tap": "#sky-ui .sky-star[data-slot=\"slot-34\"]" },
	{ "wait": 500 },
	{ "expect": "window.__cellestial.claims.picked() === 'slot-34' && window.__cellestial.claims.all().size === 0" },
	{ "shot": "1-panel" },
	{ "click": "#sky-ui [data-sky-claim]" },
	{ "wait": 600 },
	{ "fill": ["#claim-form-name", "Test Visitor"] },
	{ "fill": ["#claim-form-email", "visitor@example.com"] },
	{ "fill": ["#claim-form-message", "A site for my bakery, with the week's bread on the first page."] },
	{ "expect": "document.querySelector('#claim-form [data-star-input]').value === 'slot-34'" },
	{ "expect": "window.__cellestial.claims.all().size === 0 && !window.__cellestial.sky.hooks.isLit('slot-34')" },
	{ "shot": "2-request" },
	{ "click": "#claim-form button[type=\"submit\"]" },
	{ "wait": 700 },
	{ "expect": "window.__cellestial.claims.isLit('slot-34')" },
	{ "shot": "3-sent" },
	{ "wait": 2150 },
	{ "shot": "4-claim-0" },
	{ "wait": 250 },
	{ "shot": "4-claim-1" },
	{ "wait": 250 },
	{ "shot": "4-claim-2" },
	{ "wait": 1800 },
	{ "expect": "window.__cellestial.sky.hooks.isLit('slot-34') && document.querySelector('#sky-ui [data-sky-ask]').textContent === \"A site for my bakery, with the week's bread on the first page.\"" },
	{ "shot": "5-lit" },
	{ "reload": true },
	{ "wait": 2200 },
	{ "expect": "window.__cellestial.claims.isLit('slot-34') && window.__cellestial.sky.hooks.isLit('slot-34')" },
	{ "shot": "6-reloaded" }
]
