---
// The Sky's own test page: the scene mounted alone, with stand-ins for the
// rest of the stage. Development only; src/pages/dev/ is deleted before the
// final build.
//
//   layer=<n>            start at that layer's station (fractions are between two)
//   still=1              reduced motion
//   intro=1              play the loader's hand-off (introT=<0..1> freezes it)
//   fall=1               play the fall against a stand-in soil
//   focus=<slot>         fly in on a star (ignite=1 plays the claim there)
//   lit=slot-3,slot-17   stars lit from the start
//   unplaced=<text>      a request already sent with no star chosen
//   freeze=<seconds>     pin the animation clock (step it with __sky.debug.setClock)
//   level=<n>            hold the governor at one level
//   hud=1                frame time and governor level
//   active=0             mount without activating
import Sky from '../../components/scenes/Sky.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex" />
		<title>Sky: scene test</title>
		<style is:global>
			html,
			body {
				margin: 0;
				height: 100%;
				background: #000;
				overflow: hidden;
				overscroll-behavior: none;
			}
			/* The stand-in soil: opaque, above the canvas, rising from the bottom. */
			#dev-soil {
				position: fixed;
				inset: 0;
				z-index: 1;
				background: #1d1817;
				border-top: 1px solid #493321;
				transform: translateY(100vh);
				pointer-events: none;
			}
			#dev-impact {
				position: fixed;
				top: 0;
				left: 0;
				z-index: 3;
				width: 2px;
				height: 14px;
				margin: -14px 0 0 -1px;
				background: #6480ce;
				pointer-events: none;
			}
			/* The stand-in for the loader's little star: where it is, and how big. */
			#dev-loader-star {
				position: fixed;
				top: 0;
				left: 0;
				z-index: 3;
				box-sizing: border-box;
				border: 1px solid #ae8a68;
				border-radius: 50%;
				pointer-events: none;
			}
			#dev-hud {
				position: fixed;
				left: 8px;
				bottom: 8px;
				z-index: 60;
				margin: 0;
				padding: 6px 8px;
				background: rgb(0 0 0 / 0.7);
				color: #daeff8;
				font: 11px/1.4 ui-monospace, monospace;
				pointer-events: none;
				white-space: pre;
			}
			[hidden] {
				display: none !important;
			}
		</style>
	</head>
	<body>
		<Sky />
		<div id="dev-soil" hidden></div>
		<div id="dev-impact" hidden></div>
		<div id="dev-loader-star" hidden></div>
		<pre id="dev-hud" hidden></pre>
		<script>
			import { ASSETS } from '../../experience/assets.ts';
			import type { ScreenCircle, SlotId } from '../../experience/contracts.ts';
			import {
				createContext,
				createLogClaimFlow,
				createLogDirector,
				createMemoryClaims,
				log,
			} from '../../experience/sky/dev/standins.ts';
			import type { SkyEvents, SkyInternals } from '../../experience/sky/hooks.ts';
			import { hooksOf, mount } from '../../experience/sky/index.ts';
			import { isSlotId } from '../../content/constellations.ts';

			const q = new URLSearchParams(location.search);
			const num = (key: string) => {
				const v = q.get(key);
				if (v === null || v === '') return null;
				const n = Number(v);
				return Number.isFinite(n) ? n : null;
			};
			const reduced = q.get('still') === '1';

			const claims = createMemoryClaims(
				(q.get('lit') ?? '')
					.split(',')
					.map((s) => s.trim())
					.filter(Boolean),
				q.get('unplaced'),
			);
			const director = createLogDirector(reduced);
			const claimFlow = createLogClaimFlow();
			const scene = mount(createContext({ claims, director, claimFlow }, reduced)) as SkyInternals;
			const hooks = hooksOf(scene);
			const debug = scene.debug;

			const events: { type: string; at: number; detail: unknown }[] = [];
			const watch = <K extends keyof SkyEvents>(type: K) =>
				hooks?.on(type, (detail) => {
					events.push({ type, at: Math.round(performance.now()), detail });
				});
			watch('tap-empty');
			watch('star-pick');
			watch('station');
			watch('round-complete');
			watch('ignite');
			watch('focus');

			const soil = document.getElementById('dev-soil') as HTMLElement;
			const impact = document.getElementById('dev-impact') as HTMLElement;
			const loaderStar = document.getElementById('dev-loader-star') as HTMLElement;
			const hud = document.getElementById('dev-hud') as HTMLElement;

			/** Where the star above the "i" would be: the wordmark centred, 90% of the width, 900 px at most. */
			const loaderCircle = (): ScreenCircle => {
				const mark = ASSETS.loader.wordmark;
				const width = Math.min(0.9 * window.innerWidth, 900);
				const k = width / mark.w;
				const left = (window.innerWidth - width) / 2;
				const top = (window.innerHeight - mark.h * k) / 2;
				return { x: left + mark.star.x * k, y: top + mark.star.y * k, r: mark.star.r * k };
			};

			const showLoaderStar = (at: ScreenCircle, on: boolean) => {
				loaderStar.hidden = !on;
				loaderStar.style.width = loaderStar.style.height = `${2 * at.r}px`;
				loaderStar.style.transform = `translate(${at.x - at.r}px, ${at.y - at.r}px)`;
			};

			/** The hand-off, driven the way the loader will drive it. */
			const playIntro = (seconds = 1.6, holdAt: number | null = null) => {
				const at = loaderCircle();
				scene.introPrime(at);
				if (holdAt !== null) {
					showLoaderStar(at, holdAt <= 0);
					scene.introProgress(holdAt);
					return Promise.resolve();
				}
				showLoaderStar(at, false);
				return new Promise<void>((resolve) => {
					const began = performance.now();
					const tick = (now: number) => {
						const t = Math.min(1, (now - began) / (seconds * 1000));
						scene.introProgress(t);
						if (t < 1) requestAnimationFrame(tick);
						else {
							scene.setActive(true);
							resolve();
						}
					};
					requestAnimationFrame(tick);
				});
			};

			/** The fall, against a soil that rises on the sky's own clock (so a pinned clock pins it too). */
			let fallBegan = -1;
			const groundY = () => {
				const h = window.innerHeight;
				if (fallBegan < 0 || !hooks) return h + 1;
				const t = Math.min(1, Math.max(0, (hooks.time() - fallBegan - 0.25) / 1.5));
				const e = t * t * (3 - 2 * t);
				return h - e * 0.42 * h;
			};
			const placeSoil = () => {
				soil.style.transform = `translateY(${groundY()}px)`;
			};
			const startFall = () => {
				if (!hooks) return Promise.resolve();
				fallBegan = hooks.time();
				soil.hidden = false;
				impact.hidden = true;
				placeSoil();
				events.push({ type: 'fall-start', at: Math.round(performance.now()), detail: null });
				return scene
					.fall({
						groundY,
						onImpact(x) {
							impact.hidden = false;
							impact.style.transform = `translate(${x}px, ${groundY()}px)`;
							events.push({ type: 'impact', at: Math.round(performance.now()), detail: { x } });
						},
					})
					.then(() => {
						events.push({ type: 'fall-done', at: Math.round(performance.now()), detail: null });
					});
			};
			const restore = () => {
				fallBegan = -1;
				soil.hidden = true;
				impact.hidden = true;
				scene.restore();
			};
			hooks?.on('frame', placeSoil);

			if (q.get('hud') === '1' && hooks) {
				hud.hidden = false;
				const recent: number[] = [];
				hooks.on('frame', () => {
					const ms = hooks.quality().frameMs;
					if (ms > 0) recent.push(ms);
					if (recent.length > 60) recent.shift();
				});
				setInterval(() => {
					const quality = hooks.quality();
					const flight = hooks.flight();
					const mean = recent.length ? recent.reduce((a, b) => a + b, 0) / recent.length : 0;
					const worst = recent.length ? Math.max(...recent) : 0;
					hud.textContent =
						`frame ${mean.toFixed(1)} ms  worst ${worst.toFixed(1)}\n` +
						`level ${quality.level}/${quality.levels - 1}  dpr ${quality.dpr}\n` +
						`${flight.mode}  layer ${flight.coord.toFixed(2)}  v ${flight.vel.toFixed(2)}\n` +
						`round ${scene.roundComplete() ? 'complete' : 'open'}`;
				}, 200);
			}

			const page = {
				scene,
				hooks,
				debug,
				claims,
				director,
				claimFlow,
				events,
				log,
				loaderCircle,
				playIntro,
				startFall,
				restore,
				groundY,
				state: 'mounting' as 'mounting' | 'ready' | 'failed',
				error: null as string | null,
			};
			(window as unknown as { __sky: typeof page }).__sky = page;

			scene.ready.then(
				async () => {
					const layer = num('layer');
					if (layer !== null) debug?.setCoord(layer);
					const level = num('level');
					if (level !== null) debug?.setLevel(level);
					const intro = q.get('intro') === '1' || q.has('introT');
					if (q.get('active') !== '0' && !intro) scene.setActive(true);
					const freeze = num('freeze');
					if (freeze !== null) debug?.setClock(freeze);

					if (intro) void playIntro(1.6, num('introT'));
					if (q.get('fall') === '1') void startFall();
					const focus = q.get('focus');
					if (focus && isSlotId(focus)) {
						let done = false;
						const going = scene
							.focusStar(focus as SlotId, { ignite: q.get('ignite') === '1' })
							.then(() => {
								done = true;
							});
						if (freeze !== null && debug && hooks) {
							// Run the fly-in on the pinned clock, then put the clock back.
							for (let i = 0; i < 400 && !done; i++) {
								debug.setClock(hooks.time() + 0.05);
								await Promise.resolve();
							}
							debug.setClock(freeze);
						} else {
							await going;
						}
					}
					page.state = 'ready';
				},
				(err) => {
					page.state = 'failed';
					page.error = String(err);
				},
			);
		</script>
	</body>
</html>
