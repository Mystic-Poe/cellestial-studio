---
// The Sky (B): the canvas the flight is drawn on, and the layer its controls
// live in. src/experience/sky/index.ts mounts on these two elements.
//
// The canvas is the picture and is hidden from assistive tech; every star of
// the layer in front has a real, transparent <button> in #sky-ui, kept over
// it by the scene, and that is what a visitor picks with.
---

<canvas id="sky-canvas" aria-hidden="true"></canvas>
<div id="sky-ui"></div>

<style is:global>
	#sky-canvas {
		position: fixed;
		inset: 0;
		z-index: 0;
		display: block;
		width: 100%;
		height: 100%;
		background: #000;
		/* The flight owns a touch that begins on the sky. */
		touch-action: none;
		-webkit-tap-highlight-color: transparent;
		user-select: none;
		-webkit-user-select: none;
	}

	#sky-ui {
		position: fixed;
		inset: 0;
		z-index: 2;
		overflow: hidden;
		pointer-events: none;
	}

	#sky-ui .sky-stars {
		position: absolute;
		inset: 0;
		pointer-events: none;
	}

	#sky-ui .sky-stars[hidden] {
		display: none;
	}

	/* One per star of the layer in front. The scene sets its size and place. */
	#sky-ui .sky-star {
		position: absolute;
		top: 0;
		left: 0;
		width: 44px;
		height: 44px;
		margin: -22px 0 0 -22px;
		padding: 0;
		border: 0;
		border-radius: 50%;
		background: transparent;
		color: inherit;
		font: inherit;
		appearance: none;
		-webkit-appearance: none;
		cursor: pointer;
		pointer-events: auto;
		touch-action: none;
		-webkit-tap-highlight-color: transparent;
		outline: none;
		will-change: transform;
	}

	#sky-ui .sky-star[hidden] {
		display: none;
	}

	#sky-ui .sky-star:focus-visible {
		outline: 2px solid var(--color-brass-hi, #d5ae88);
		outline-offset: 3px;
	}
</style>
